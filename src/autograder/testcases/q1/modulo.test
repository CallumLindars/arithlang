name:: Modulus Expression
tests:: 5

test::
    input:: (% 8 3)
    output:: 2

test::
    input:: (% 1000 3)
    output:: 1

test::
    input:: (% 169 13)
    output:: 0

test::
    input:: (% 8 3 2)
    output:: 0
    note:: "Make sure your implementation allows for more than 2 operands."

test::
    input:: (% (+ 6 6) 5)
    output:: 2